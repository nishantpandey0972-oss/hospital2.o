# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_PATH: Path to the SQLite database file for appointments and enquiries.
DATABASE_PATH="./data/hospital.db"

# PORT: Server port (defaults to 3000 in AI Studio preview environment)
PORT=3000
